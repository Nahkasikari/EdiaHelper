<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
<!--
        EdiabasLib 8.0 settings for ISTA, installed by EdiaHelper.
        The interface (STD:OBD or ENET) and the trace level (IfhTrace, ApiTrace) are taken from
        EDIABAS.INI in the same folder; EdiaHelper sets them (trace level: EDIABAS folders tab).
        AppendTrace=1: every EDIABAS start adds to the trace file instead of replacing it
        (ISTA starts EDIABAS several times; otherwise only the last start would be kept).
        K-line / D-CAN traffic goes through the EdiaHelper relay on 127.0.0.1:2323.
        RAW is required: the MHD adapter does not answer EdiabasLib's adapter checks.
-->
        <add key="ObdComPort" value="DEEPOBDWIFI:127.0.0.1:2323:RAW"/>
        <add key="ObdKeepConnectionOpen" value="1"/>
        <add key="EnetRemoteHost" value="192.168.4.1"/>
        <add key="LockTrace" value="0"/>
        <add key="AppendTrace" value="1"/>
    </appSettings>
</configuration>

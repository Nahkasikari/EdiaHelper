<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
<!--
        EdiabasLib 8.0 settings for ISTA, installed by EdiaHelper.
        ISTA chooses the interface itself (EDIABAS standard settings = STD:OBD, or ENET).
        K-line / D-CAN traffic goes through the EdiaHelper relay on 127.0.0.1:2323.
        RAW is required: the MHD adapter does not answer EdiabasLib's adapter checks.
        Keep IfhTrace at 0 except for short tests; level 3 writes gigabytes and slows everything down.
-->
        <add key="ObdComPort" value="DEEPOBDWIFI:127.0.0.1:2323:RAW"/>
        <add key="ObdKeepConnectionOpen" value="1"/>
        <add key="EnetRemoteHost" value="192.168.4.1"/>
        <add key="LockTrace" value="0"/>
        <add key="ApiTrace" value="0"/>
        <add key="IfhTrace" value="0"/>
    </appSettings>
</configuration>
